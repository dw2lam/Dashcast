+	uint64_t ntp = ntp_time();
+	{
+		std::lock_guard lock(mNtpAnchorMutex);
+		if (mHasNtpAnchor && rtpConfig->clockRate > 0) {
+			// Signed 32-bit distance: valid for timestamps within 2^31 ticks of the anchor
+			const int64_t ticks = int32_t(timestamp - mNtpAnchorRtpTimestamp);
+			const double fraction = double(ticks) * 4294967296.0 / double(rtpConfig->clockRate);
+			ntp = uint64_t(int64_t(mNtpAnchorNtpTimestamp) + int64_t(std::llround(fraction)));
+		}
